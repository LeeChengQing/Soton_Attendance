{
  "name": "attendance-extension",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "build": "node scripts/build.mjs",
    "verify:parity": "node scripts/verify-parity.mjs",
    "smoke": "node scripts/smoke.mjs",
    "keys:generate": "node scripts/generate-china-keys.js",
    "test:mv3": "node scripts/extension-smoke.mjs",
    "test:backend": "npx --yes deno@2.9.6 test --node-modules-dir=none --allow-env supabase/functions/_shared/activation.deno.ts supabase/functions/_shared/entitlement.deno.ts supabase/functions/_shared/reliability.deno.ts supabase/functions/_shared/recovery-code.deno.ts supabase/functions/_shared/checkout.deno.ts supabase/functions/_shared/notification-webhook.deno.ts",
    "candidate": "node scripts/package-candidate.mjs",
