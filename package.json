    "pdfjs-dist": "^6.3.289",
    "stripe": "23.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "esbuild": "^0.25.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "supabase": "^2.121.0"
  }
}
